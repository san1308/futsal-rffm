# Puerto local en la Raspberry (Cloudflare Tunnel apunta aquí)
PORT=8090

# Competición: salen de la URL del calendario de rffm.es
#   https://www.rffm.es/competicion/calendario?temporada=22&tipojuego=3&competicion=26738221&grupo=26771028
RFFM_TEMPORADA=22
RFFM_TIPOJUEGO=3
RFFM_COMPETICION=26738221
RFFM_GRUPO=26771028

# Tu equipo (código de /fichaequipo/XXXX en rffm.es) — C.D.E. Casco Antiguo Carabanchel 'A'
MI_EQUIPO=17146426
# Tu código de jugador (aparece en las actas). Déjalo vacío para ocultar la pestaña "Yo"
MI_JUGADOR=2799670

# Caché en segundos (no hace falta tocarlo)
TTL_CALENDARIO=600
TTL_CLASIFICACION=600
TTL_GOLEADORES=1800

# 1 = usa los datos guardados en tests/fixtures (para probar sin conexión)
DEMO=0
